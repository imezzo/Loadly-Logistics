## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/
# Exception: Don't ignore source code Packages directories
!**/Actions/Packages/
!**/Actions/Packages/**

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Publish profiles
pubxml
*.pubxml
*.publishproj

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Rider
.idea/

# macOS
.DS_Store

# Database
*.db
*.db-shm
*.db-wal

# App-specific
appsettings.Development.json
appsettings.Production.json
LoadlyAggregator.API/Properties/launchSettings.json

# Firebase credentials
firebase-service-account-key.json
*firebase*credentials*.json
*firebase*key*.json
secrets/

# Scripts
kill-app.sh
run-app.sh


LoadlyAggregator.postman_collection.json
Documentation/
wwwroot/uploads/
