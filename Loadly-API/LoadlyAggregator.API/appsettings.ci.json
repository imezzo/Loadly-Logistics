{
  "AllowedHosts": "*",
  "EgyptTime": {
    "WindowsTimeZoneId": "${EGYPT_WINDOWS_TIME_ZONE_ID}",
    "IanaTimeZoneId": "${EGYPT_IANA_TIME_ZONE_ID}"
  },
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}",
    "LogsConnection": "${DB_LOGS_CONNECTION_STRING}",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpirationInMinutes": "${JWT_EXPIRATION_MINUTES}"
  },
  "AuthSettings": {
    "MfaTokenMinutes": 60,
    "MfaCodeMinutes": 30,
    "PasswordResetHours": 2,
    "PasswordResetCodeMinutes": 60,
    "RateLimitMinutes": 60,
    "MaxFailedAttempts": 5,
    "PermissionCacheMinutes": 60,
    "RefreshTokenDays": 7,
    "RefreshTokenCleanupIntervalHours": 24,
    "ExpiredTokenRetentionDays": 7,
    "RevokedTokenRetentionDays": 30,
    "CleanupBatchSize": 1000,
    "PreferredCleanupStartHour": 2,
    "PreferredCleanupEndHour": 4
  },
  "SmtpSettings": {
    "Host": "${SMTP_HOST}",
    "Port": "${SMTP_PORT}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "${SMTP_FROM_NAME}",
    "EnableSsl": "${SMTP_ENABLE_SSL}",
    "UseDefaultCredentials": "${SMTP_USE_DEFAULT_CREDENTIALS}"
  },
  "Sms": {
    "Provider": "${SMS_PROVIDER}",
    "Akedly": {
      "ApiKey": "${AKEDLY_API_KEY}",
      "PipelineId": "${AKEDLY_PIPELINE_ID}",
      "ApiUrl": "${AKEDLY_API_URL}"
    },
    "VictoryLink": {
      "Username": "${VICTORY_LINK_USERNAME}",
      "Password": "${VICTORY_LINK_PASSWORD}",
      "SenderName": "${VICTORY_LINK_SENDER_NAME}",
      "ApiUrl": "${VICTORY_LINK_API_URL}"
    },
    "UltraMsg": {
      "Token": "${ULTRAMSG_TOKEN}",
      "InstanceId": "${ULTRAMSG_INSTANCE_ID}"
    }
  },
  "Firebase": {
    "CredentialsPath": "${FIREBASE_CREDENTIALS_PATH}",
    "CredentialsJson": "${FIREBASE_CREDENTIALS_JSON}"
  },
  "OpenAI": {
    "ApiKey": "${OPENAI_API_KEY}",
    "Organization": "${OPENAI_ORGANIZATION}",
    "Model": "${OPENAI_MODEL}"
  },
  "GoogleMaps": {
    "ApiKey": "${GOOGLE_MAPS_API_KEY}",
    "DefaultCountryCode": "${GOOGLE_MAPS_DEFAULT_COUNTRY_CODE}"
  },
  "OdometerOcr": {
    "Provider": "${ODOMETER_OCR_PROVIDER}"
  },
  "Media": {
    "StorageProvider": "${STORAGE_PROVIDER}",
    "ImagesServerDomain": "${CDN_DOMAIN}",
    "CdnMainFolder": "${CDN_MAIN_FOLDER}",
    "StoragePath": "${STORAGE_PATH}",
    "AwsS3": {
      "BucketName": "${AWS_S3_BUCKET}",
      "Region": "${AWS_REGION}",
      "AccessKey": "${AWS_ACCESS_KEY}",
      "SecretKey": "${AWS_SECRET_KEY}",
      "CdnDomain": "${AWS_CDN_DOMAIN}"
    },
    "AzureBlob": {
      "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=...",
      "ContainerName": "uploads",
      "CdnDomain": "https://yourstorageaccount.blob.core.windows.net"
    },
    "GoogleCloud": {
      "BucketName": "your-bucket-name",
      "CredentialsPath": "path/to/service-account-key.json",
      "CdnDomain": "https://storage.googleapis.com/your-bucket"
    }
  },
  "Queue": {
    "Queues": [
      "admin",
      "company",
      "driver",
      "contractor"
    ],
    "PollingIntervalMs": 1000,
    "ErrorRetryDelayMs": 5000,
    "BroadcastNotificationBatchSize": 200
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}"
  },
  "Rollbar": {
    "AccessToken": "${ROLLBAR_ACCESS_TOKEN}",
    "Environment": "${ROLLBAR_ENVIRONMENT}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "${LOG_LEVEL_DEFAULT}",
      "Override": {
        "Microsoft": "${LOG_LEVEL_ASPNETCORE}",
        "Microsoft.EntityFrameworkCore": "${LOG_LEVEL_ASPNETCORE}",
        "Microsoft.EntityFrameworkCore.Query": "None",
        "System": "${LOG_LEVEL_ASPNETCORE}"
      }
    },
    "Exporters": [
      "console",
      "file",
      "seq"
    ],
    "Console": {
      "Enabled": true
    },
    "File": {
      "Enabled": true,
      "Path": "logs/app-.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30,
      "FileSizeLimitBytes": 10485760
    },
    "Seq": {
      "Enabled": true,
      "ServerUrl": "${SEQ_SERVER_URL}",
      "ApiKey": "${SEQ_API_KEY}"
    },
    "Elasticsearch": {
      "Enabled": false,
      "NodeUris": "${Elasticsearch_NodeUris}",
      "IndexFormat": "loadly-aggregator-logs-{0:yyyy.MM.dd}"
    }
  },
  "BroadcastShare": {
    "PublicBaseUrl": "${BROADCAST_SHARE_PUBLIC_BASE_URL}"
  },
  "ResetPasswordUrls": {
    "Admin": {
      "BaseUrl": "${ADMINURL}",
      "Path": "/auth/reset-password"
    },
    "Driver": {
      "BaseUrl": "${DRIVERURL}",
      "Path": "/auth/reset-password"
    },
    "Company": {
      "BaseUrl": "${COMPANYURL}",
      "Path": "/auth/reset-password"
    },
    "Contractor": {
      "BaseUrl": "${CONTRACTORURL}",
      "Path": "/auth/reset-password"
    },
    "Collector": {
      "BaseUrl": "${COLLECTORURL}",
      "Path": "/auth/reset-password"
    }
  },
  "Cors": {
    "AllowedOrigins": "${CORS_ALLOWED_ORIGINS}"
  }
}