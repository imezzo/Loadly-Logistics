{
  "name": "loadly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "run-p dev:admin dev:app dev:company",
    "dev:admin": "vite --mode admin-dashboard",
    "dev:app": "vite --mode app-dashboard",
    "dev:company": "vite --mode company-dashboard",
    "build": "run-s build:admin build:app build:company",
    "build:admin": "vite build --mode admin-dashboard",
    "build:app": "vite build --mode app-dashboard",
    "build:company": "vite build --mode company-dashboard",
    "preview": "run-p preview:admin preview:app preview:company",
    "preview:admin": "vite preview --mode admin-dashboard",
    "preview:app": "vite preview --mode app-dashboard",
    "preview:company": "vite preview --mode company-dashboard",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "prepare": "husky install"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "cookie-universal": "^2.2.2",
    "country-flags-dial-code": "^1.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.12.34",
    "pinia": "^3.0.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tsconfig/node24": "^24.0.3",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-better-tailwindcss": "^3.7.11",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-vue": "~10.5.1",
    "husky": "^8.0.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "^1.8.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
